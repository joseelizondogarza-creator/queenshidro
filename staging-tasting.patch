+/* ─── CRM TASTINGS ─── */
+var tastingStatusLabels={nuevo:'Nuevo',en_revision:'En revisión',confirmado:'Confirmado',atendido:'Atendido',descartado:'Descartado'};
+var tastingTypeLabels={local:'Visita local',nacional:'Solicitud nacional'};
+var tastingLeadLabels={botella:'Botella',barril:'Barril'};
+
+async function loadTastingRequests(){
+  var filter=document.getElementById('tastingFilterStatus').value;
+  var query=sb.from('tasting_requests').select('*').order('created_at',{ascending:false});
+  if(filter)query=query.eq('status',filter);
+  var {data,error}=await query;
+  if(error){document.getElementById('tastingsTable').innerHTML='<p style="color:var(--red);padding:20px">Error al cargar las degustaciones.</p>';return}
+  var rows=data||[];
+  if(!rows.length){document.getElementById('tastingsTable').innerHTML='<p style="color:var(--muted);padding:20px">No hay solicitudes de degustación.</p>';return}
+  var html=rows.map(function(r){
+    var date=r.desired_date?new Date(r.desired_date+'T12:00:00').toLocaleDateString('es-MX',{day:'numeric',month:'short',year:'numeric'}):'—';
+    var created=r.created_at?new Date(r.created_at).toLocaleDateString('es-MX',{day:'numeric',month:'short'}):'—';
+    var place=r.request_type==='local'?(r.municipality||'Monterrey'):[r.city,r.state].filter(Boolean).join(', ');
+    var status=r.status||'nuevo';
+    var options=Object.keys(tastingStatusLabels).map(function(key){return '<option value="'+key+'"'+(key===status?' selected':'')+'>'+tastingStatusLabels[key]+'</option>'}).join('');
+    return '<tr>'+
+      '<td><strong>'+escapeHtml(r.company||'Sin negocio')+'</strong><br><span style="font-size:0.7rem;color:var(--muted)">'+escapeHtml(r.full_name||'')+'</span></td>'+
+      '<td style="font-size:0.74rem;color:var(--muted)">'+escapeHtml(r.email||'—')+'<br>'+escapeHtml(r.phone||'')+'</td>'+
+      '<td style="font-size:0.75rem">'+(tastingTypeLabels[r.request_type]||escapeHtml(r.request_type||'—'))+'<br><span style="color:var(--muted)">'+escapeHtml(place||'—')+'</span></td>'+
+      '<td style="font-size:0.75rem">'+escapeHtml(date)+'<br><span style="color:var(--teal-hi)">'+escapeHtml(tastingLeadLabels[r.lead_type]||r.lead_type||'—')+'</span></td>'+
+      '<td style="font-size:0.74rem;color:var(--muted);max-width:180px">'+escapeHtml(r.desired_volume||'—')+'</td>'+
+      '<td><select class="form-select tasting-status-select" data-id="'+r.id+'" style="min-width:130px;padding:7px 9px;font-size:0.72rem">'+options+'</select></td>'+
+      '<td style="font-size:0.7rem;color:var(--muted)">'+escapeHtml(created)+'</td>'+
+    '</tr>';
+  }).join('');
+  document.getElementById('tastingsTable').innerHTML='<table><thead><tr><th>Negocio</th><th>Contacto</th><th>Tipo / Ubicación</th><th>Fecha / Formato</th><th>Volumen</th><th>Estado</th><th>Recibido</th></tr></thead><tbody>'+html+'</tbody></table>';
+}
+
+async function updateTastingStatus(id,status){
+  var payload={status:status,updated_at:new Date().toISOString(),reviewed_at:status==='nuevo'?null:new Date().toISOString()};
+  var {error}=await sb.from('tasting_requests').update(payload).eq('id',id);
+  if(error){toast('No se pudo actualizar la degustación','err');loadTastingRequests();return}
+  toast('Estado actualizado');
+}
+
